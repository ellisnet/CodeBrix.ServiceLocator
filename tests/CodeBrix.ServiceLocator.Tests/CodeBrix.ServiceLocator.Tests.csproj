<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Must be set explicitly. RootNamespace otherwise defaults to the project
         name (CodeBrix.ServiceLocator.Tests), and xUnit v3 emits its generated
         obj/**/SelfRegisteredExtensions.cs into that namespace, which would
         re-create a `CodeBrix.ServiceLocator` namespace inside this assembly and
         reintroduce the very collision NamespaceCollisionGuardTests.cs guards
         against. The AssemblyName stays CodeBrix.ServiceLocator.Tests to match
         the InternalsVisibleTo grant. -->
    <RootNamespace>CodeBrix.ServiceLocation.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.237.1200" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.ServiceLocator\CodeBrix.ServiceLocator.csproj" />
  </ItemGroup>

</Project>
